ARC_RPC_URL=https://rpc.testnet.arc.network
CONTRACT_ADDRESS=0xFc7dE289e02FCFB4268AE8f0e49991D2Eafe5C87

# Choose Discord, Telegram, or both. Never commit real values.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local smoke tests only. Keep false when a real channel is configured.
LISTENER_STDOUT=false

POLL_INTERVAL_MS=8000
CONFIRMATIONS=2
BLOCK_CHUNK_SIZE=500
LISTENER_STATE_FILE=data/state.json

# Optional replay point. Omit in normal operation to begin at the latest block.
# LISTENER_START_BLOCK=59320000
