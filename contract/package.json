{
  "name": "arc-agent-marketplace-contract",
  "version": "1.0.0",
  "description": "AI Agent Job Marketplace smart contract for Arc Testnet",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "build:v2": "hardhat clean --config hardhat.v2.config.js && hardhat compile --config hardhat.v2.config.js",
    "test:v2": "hardhat test --config hardhat.v2.config.js --network hardhat",
    "size:v2": "npm run build:v2 && node scripts/check-v2-size.js",
    "verify:config": "hardhat run --no-compile scripts/verify-build-config.js && node scripts/verify-deployment-manifests.js",
    "verify:artifact": "node scripts/verify-artifact-identity.js",
    "attest:deployment": "node scripts/attest-deployment.js",
    "deploy:verification": "hardhat run scripts/deploy.js --network arcTestnet",
    "deploy:live-testnet": "hardhat run scripts/deploy.js --network arcTestnet",
    "deploy:production": "hardhat run scripts/deploy.js --network arcTestnet",
    "showcase:live-testnet": "node scripts/populate-live-testnet-showcase.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "hardhat": "2.28.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "dotenv": "16.6.1"
  }
}
