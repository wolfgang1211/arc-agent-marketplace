# Copy this file to ".env" and fill in the values. NEVER commit the real .env file.

# A TESTNET wallet private key (no 0x prefix is fine; with 0x also works).
# Use a throwaway wallet that only holds Arc Testnet funds. Never your real wallet.
PRIVATE_KEY=

# Arc Testnet RPC (default is fine)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
